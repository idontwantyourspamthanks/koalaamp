# --- App runtime state (never commit user data) ------------------------------------------------
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log
logs/
cache/
settings.json
*.eqf.bak

# --- OS noise -------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets guard (defense in depth — never commit credentials) ---------------------------
.env
.env.*
*.pem
*.key
!test/fixtures/*.key
secrets/
*.local

# --- Docs byproducts -----------------------------------------------------------------------
*.tmp
~$*
